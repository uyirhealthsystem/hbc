NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/home_care

# ---- Who is calling (works without the api-gateway) ----
# Apps call HBC directly with Authorization: Bearer <authservice access token> (sub = user id, role claim).
# authservice JWKS that verifies those tokens. Unset = only decoded (development only; required in production).
# AUTH_JWKS_URL=http://auth-service:4000/.well-known/jwks.json
# JWT_ISSUER=
# JWT_AUDIENCE=patient-app,service-provider-app,superadmin-app
# Local testing: also accept X-User-Id + X-User-Role with no token. Defaults to true outside production.
# TRUST_IDENTITY_HEADERS=true
# Later, with the api-gateway in front: requests carrying this as X-Gateway-Secret are identified by its
# X-User-Id / X-User-Role headers.
# GATEWAY_SHARED_SECRET=

# Max wrong OTP attempts before the visit OTP is locked
OTP_MAX_ATTEMPTS=5

# Providers see bookings in their own pincode, or within this many km of their location
SERVICE_RADIUS_KM=10

# ---- Uyir payment-service (Razorpay behind it) ----
# Base URL: payment-service directly (http://payment-service:8083) or the api-gateway (/api/payments/** is routed).
PAYMENT_SERVICE_URL=https://uyirhealthapp.com
# http = payment-service (Razorpay); mock = every booking paid at once, no payment-service (local only)
PAYMENT_PROVIDER=http
# Verifies the signed PAID / FAILED callbacks on POST /api/v1/hbc/payments/webhook.
# Must equal payment-service HOMECARE_PAYMENT_WEBHOOK_SECRET (openssl rand -hex 32). Local profile default below.
PAYMENT_WEBHOOK_SECRET=local-homecare-payment-secret
# referenceType registered in payment-service as payment.consumers[HOME_CARE_BOOKING]
# PAYMENT_REFERENCE_TYPE=HOME_CARE_BOOKING
# PAYMENT_TIMEOUT_MS=15000
# LOCAL ONLY: send X-User-Id / X-User-Role (payment-service local profile) instead of forwarding the bearer token.
# Leave unset/false anywhere else; production refuses to start with it.
PAYMENT_SEND_IDENTITY_HEADERS=false
