# Copy to /opt/hbc/shared/hbc.env on the EC2 host and fill in.
# NEVER commit the real file.

NODE_ENV=production
PORT=4000

# Postgres (Neon / RDS)
DATABASE_URL=

OTP_MAX_ATTEMPTS=5
SERVICE_RADIUS_KM=10

# ---- Who is calling: Authorization: Bearer <authservice access token> ----
# Required in production: verifies the bearer tokens.
AUTH_JWKS_URL=http://15.252.58.211:4000/.well-known/jwks.json
# JWT_ISSUER=
# JWT_AUDIENCE=
# Later, with the api-gateway in front (requests carrying it as X-Gateway-Secret use X-User-Id / X-User-Role):
# GATEWAY_SHARED_SECRET=

# ---- Uyir payment-service (Razorpay behind it) ----
PAYMENT_SERVICE_URL=https://uyirhealthapp.com
# Must equal payment-service HOMECARE_PAYMENT_WEBHOOK_SECRET (openssl rand -hex 32)
PAYMENT_WEBHOOK_SECRET=
PAYMENT_PROVIDER=http
# PAYMENT_REFERENCE_TYPE=HOME_CARE_BOOKING
# PAYMENT_TIMEOUT_MS=15000
